---
import Base from "../layouts/Base.astro";
import { packs, url } from "../lib/registry";
const all = packs();
---
<Base title="Symbolon packs" search>
  <h1>Spec packs</h1>
  <p class="muted">
    Each pack holds the decisions a builder could not guess, with a check for each.
    Point your coding agent at one, build in any stack, and prove the build with <code>symbolon attest</code>.
  </p>
  <div id="search" style="margin: 20px 0 28px"></div>
  <div style="display: grid; gap: 12px">
    {all.map((p) => (
      <a class="card" href={url(`packs/${p.id}/`)} style="text-decoration: none; color: inherit; display: block">
        <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: baseline">
          <strong>{p.id}</strong>
          <span class="muted">version {p.version} · {p.license}</span>
        </div>
        <div>{p.title}</div>
        <div class="muted" style="font-size: 14px">{p.summary_line}</div>
      </a>
    ))}
  </div>
  <script is:inline define:vars={{ ui: url("pagefind/pagefind-ui.js") }}>
    const s = document.createElement("script");
    s.src = ui;
    s.onload = () => new PagefindUI({ element: "#search", showSubResults: true, resetStyles: false });
    document.head.appendChild(s);
  </script>
</Base>
