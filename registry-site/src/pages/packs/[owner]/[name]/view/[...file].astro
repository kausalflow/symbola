---
import { marked } from "marked";
import Base from "../../../../../layouts/Base.astro";
import { packs, readFile, url, type Pack } from "../../../../../lib/registry";

export function getStaticPaths() {
  return packs().flatMap((pack) => {
    const [owner, name] = pack.id.split("/");
    return pack.files.map((file) => ({ params: { owner, name, file }, props: { pack, file } }));
  });
}

const { pack, file } = Astro.props as { pack: Pack; file: string };
const text = readFile(pack, file);
const html = file.endsWith(".md") ? marked.parse(text) : null;
---
<Base title={`${file} · ${pack.id}`}>
  <p style="margin-top: 24px" class="wrap">
    <a href={url(`packs/${pack.id}/`)}>{pack.id}</a> / <code>{file}</code>
    · <a href={url(`packs/${pack.id}/files/${file}`)}>raw</a>
  </p>
  {html ? <div set:html={html} /> : <pre>{text}</pre>}
  <p style="margin-bottom: 48px"></p>
</Base>
